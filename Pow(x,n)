# Implement pow(x, n), which calculates x raised to the power n (i.e., x^n).

class Solution:
    def myPow(self, x: float, n: int) -> float:
        def power(x,n):
            if(x==0):
                return 0
            if(n==0):
                return 1
            else:
                res=power(x,n//2)
                res*=res 
                if n%2==1:
                    return res*x
                return res
        ans=power(x,abs(n))
        if n>=0:
            return ans
        return 1/ans           
